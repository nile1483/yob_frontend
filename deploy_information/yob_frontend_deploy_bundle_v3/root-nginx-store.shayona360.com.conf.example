# Root/server Nginx vhost for the public Angular storefront.
# This is the OUTER Nginx running on the host, not the nginx inside the Docker container.
#
# Initial HTTP-only config. Enable it first, test it, then run:
#   sudo certbot --nginx -d store.shayona360.com
# Certbot will add/manage the HTTPS certificate and redirect.

server {
    listen 80;
    listen [::]:80;

    server_name store.shayona360.com;

    location / {
        proxy_pass http://127.0.0.1:8082;
        proxy_http_version 1.1;

        # Preserve the storefront hostname so the inner YOB Nginx can assert
        # X-YOB-Original-Host correctly when proxying API requests to Frappe.
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;

        proxy_read_timeout 120s;
    }
}
