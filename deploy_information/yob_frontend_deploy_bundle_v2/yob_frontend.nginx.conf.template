map $http_x_forwarded_proto $yob_forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 50m;

    # YOB/Frappe API. Angular production uses relative /api/method/... URLs.
    location /api/ {
        proxy_pass http://${FRAPPE_UPSTREAM};
        proxy_http_version 1.1;

        # Route the request to the correct Frappe site while preserving the
        # actual storefront hostname separately for YOB application security.
        proxy_set_header Host ${FRAPPE_SITE_HOST};
        proxy_set_header X-YOB-Original-Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $yob_forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;

        proxy_read_timeout 120s;
    }

    # Frappe returns public file/image references as /files/....
    location /files/ {
        proxy_pass http://${FRAPPE_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host ${FRAPPE_SITE_HOST};
        proxy_set_header X-YOB-Original-Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $yob_forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 120s;
    }

    # Keep authenticated/private file references on the same storefront origin.
    location /private/files/ {
        proxy_pass http://${FRAPPE_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host ${FRAPPE_SITE_HOST};
        proxy_set_header X-YOB-Original-Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $yob_forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 120s;
    }

    # Angular SPA routing.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
